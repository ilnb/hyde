13. Kanata

sudo groupadd uinput
sudo usermod -aG uinput,input $USER

# put this in /etc/udev/rules.d/99-input.rules
KERNEL=="uinput", MODE="0660", GROUP="uinput", OPTIONS+="static_node=uinput"

sudo udevadm control --reload
sudo udevadm trigger --verbose --sysname-match=uinput
sudo modprobe uinput
yin kanata-bin
g clone git@github.com:ilnb/kanata
# check the input file
ll /dev/uinput
# the permissions should be something like
crw-rw----

# if not, that can mean that the group is not a system group,
# and as udev-rules are applied for system groups only, the rule won't be applied.
# this command can be used to check the GID, < 1000 for system groups
getent group uinput
# if greater, check for a free slot using
grep -E '^[^:]+:[^:]+:[0-9]{1,3}:' /etc/group | sort -t: -k3 -n
# suppose 946 is free. then this would change the GID
sudo groupmod -g 946 uinput

